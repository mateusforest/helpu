# Opcional: copie para .env.local na raiz do projeto. Funciona sem este arquivo.
# Prioridade: ambiente/terminal > .env.local > .env.
HELPU_PORT=4173
HELPU_BIND=127.0.0.1
# Caminhos relativos sao resolvidos a partir da pasta do projeto.
HELPU_DATA_DIR=.local-data
# Opcional, para Contas conectadas. Use aspas se houver espacos.
# HELPU_BROWSER_EXECUTABLE="C:/Program Files/Google/Chrome/Application/chrome.exe"
# Uso local: mantenha HELPU_PUBLIC_URL ausente. Veja GUIA-DO-PORTAL.md para HTTPS.
# Login Instagram e faturamento Stripe: configure valores apenas na hospedagem.
# Veja CONTA-E-CONEXOES.md para ativacao e testes.
# HELPU_PUBLIC_URL=https://helpu-seven.vercel.app
# HELPU_INSTAGRAM_APP_ID=
# HELPU_INSTAGRAM_APP_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=

# OpenAI: preencha a chave somente no arquivo privado ou na Vercel (Production).
# Chave/modelos salvos em Conexoes da empresa tem prioridade sobre estes padroes.
# A chave do servidor atende empresas sem chave propria; o consumo usa sua conta.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Opcional: modelo das tarefas especificas (padrao atual: gpt-5-mini).
# OPENAI_TASK_MODEL=gpt-5-mini

# WhatsApp oficial da Helpu (separado dos canais dos clientes). Apenas no servidor.
# Número de teste exibido pela Meta, com código do país (ex.: 15551234567).
HELPU_WHATSAPP_NUMBER=
HELPU_WHATSAPP_PHONE_NUMBER_ID=
HELPU_WHATSAPP_ACCESS_TOKEN=
HELPU_WHATSAPP_APP_SECRET=
HELPU_WHATSAPP_VERIFY_TOKEN=
HELPU_WHATSAPP_API_VERSION=v24.0
HELPU_WHATSAPP_DAILY_MESSAGES=60

# Fila de criacao online: configurar somente na Vercel/servidor.
# HELPU_PUBLIC_URL=https://www.helpumkt.com
# HELPU_AUTOMATIONS_ENABLED=true
# CRON_SECRET=<segredo aleatorio privado com pelo menos 32 caracteres>
# Reels na Vercel usa os binarios incluidos no build, sem servidor adicional.
# Localmente, podem ser definidos caminhos completos para FFmpeg e ffprobe.
# HELPU_FFMPEG_PATH=
# HELPU_FFPROBE_PATH=

# IDs dos usuários da equipe Helpu autorizados à fila de publicação assistida.
# Não usar e-mails, IDs de empresas ou dados fornecidos pelo cadastro. Vazio desativa o admin.
HELPU_OPERATOR_USER_IDS=
# Alternativa: resolver uma conta já existente, sem conceder acesso a cadastros futuros.
# Exige as duas variáveis; o corte é um timestamp Unix em milissegundos no passado.
HELPU_OPERATOR_ACCOUNT_EMAIL=
HELPU_OPERATOR_ACCOUNT_CREATED_BEFORE=

# Empresas autorizadas pela administração a usar controles de teste (IDs separados por vírgula).
# Vazio mantém os limites normais; não afeta cotas ou cobrança dos provedores.
HELPU_USAGE_TEST_ORGS=

# Optional server-owned launch catalog. Prices and products must already exist in Stripe.
# STRIPE_CATALOG_JSON=[{"id":"plan","mode":"subscription","priceId":"price_replace"},{"id":"strategy","mode":"payment","priceId":"price_replace_strategy"},{"id":"market-research","mode":"payment","priceId":"price_replace_research"},{"id":"brand-identity","mode":"payment","priceId":"price_replace_identity"}]
# Optional monthly first-charge discount; coupon must be valid and duration=once.
# STRIPE_LAUNCH_COUPON_ID=

# Boas-vindas opcionais do cadastro. Modelo Meta aprovado, sem variáveis.
# Deixe vazio para manter os envios pendentes; veja docs/whatsapp-welcome.md.
HELPU_WHATSAPP_WELCOME_TEMPLATE=
HELPU_WHATSAPP_WELCOME_LANGUAGE=pt_BR
