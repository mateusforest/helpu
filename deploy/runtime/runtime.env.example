# Instale em /etc/helpu-runtime/runtime.env com dono root e permissão 0600.
# Não coloque este arquivo preenchido no Git. Não compartilhe segredos pelo chat.
HELPU_RUNTIME_DOMAIN=runtime.helpumkt.com
HELPU_ACME_EMAIL=configure-um-email-administrativo@example.com
HELPU_PUBLIC_URL=https://www.helpumkt.com
HELPU_RUNTIME_SECRET=
CRON_SECRET=
HELPU_BROWSER_MAX_SESSIONS=4
HELPU_RUNTIME_MEMORY=6g
HELPU_RUNTIME_CPUS=4
