{
  email {$HELPU_ACME_EMAIL}
  admin off
}

{$HELPU_RUNTIME_DOMAIN} {
  # Access logs are intentionally disabled: runtime requests may contain login input.
  header {
    -Server
    Cache-Control "private, no-store"
    X-Content-Type-Options "nosniff"
  }
  @api path /v1/*
  handle @api {
    request_body {
      max_size 51MiB
    }
    reverse_proxy runtime:8080 {
      transport http {
        dial_timeout 5s
        response_header_timeout 300s
      }
    }
  }
  handle {
    respond 404
  }
}
