# Instale em /etc/helpu-runtime/network.env (root, 0644).
# Escolha uma sub-rede sem conflito com redes Docker/VPC/VPN existentes.
HELPU_NETWORK_SUBNET=172.30.80.0/24
HELPU_NETWORK_GATEWAY=172.30.80.1
HELPU_RUNTIME_IP=172.30.80.10
HELPU_CADDY_IP=172.30.80.20
# Somente resolvedores DNS com IPv4 público. Docker mantém o DNS interno 127.0.0.11.
HELPU_DNS1=1.1.1.1
HELPU_DNS2=9.9.9.9
