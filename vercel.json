{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build-landing.mjs",
  "outputDirectory": ".superdesign/vercel-landing",
  "redirects": [
    {"source": "/cadastro.html", "destination": "/#acesso", "permanent": false},
    {"source": "/entrar.html", "destination": "/#acesso", "permanent": false},
    {"source": "/conta.html", "destination": "/#acesso", "permanent": false},
    {"source": "/portal.html", "destination": "/#acesso", "permanent": false}
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"}
    ]
  }]
}
